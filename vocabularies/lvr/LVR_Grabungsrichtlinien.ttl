    skos:broader lvr:c_befundansprachen ;
    skos:definition "Fundkonzentration ist ein Allgemeinbegriff in der Archäologie, der eine Ansammlung von Funden, die auf einer abgrenzbaren Fläche zusammenliegen und chronologisch einer bestimmbaren Epoche angehören, umfasst."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk007148> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fundkonzentration"@de .

lvr:c_4dc5a34d a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_b6ad07f9 ;
    skos:definition "Ein Becken ist ein Bauwerk, das als künstliche Vertiefung oder Einmuldung mit einer gebauten Umfassung errichtet ist. Becken können unterschiedliche Formen und Größen haben und werden entsprechend ihrem Einsatzzweck gestaltet."@de ;
    skos:exactMatch <http://d-nb.info/gnd/7542598-1>,
        <http://lvr.vocnet.org/wnk/wk010598>,
        <http://vocab.getty.edu/aat/300041897> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Becken (Bauwerk)"@de ;
    skos:scopeNote "Erläuterung: Ein Becken dient in der Regel dazu, Wasser oder andere Flüssigkeiten aufzunehmen."@de .

lvr:c_53fe6b81 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befundansprachen ;
    skos:definition "Ein Beherbergungsbetrieb ist ein Betrieb, in dem Personen gegen Entgelt Übernachtungsmöglichkeiten zur Verfügung gestellt werden."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk001104> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Beherbergungsbetrieb"@de .

