lvr:c_ee8f960a a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_b39710ce ;
    skos:definition "Eine Schüssel ist ein weites und tief gewölbtes Gefäß. Sie kann einen Fuß, Griffe und einen Deckel besitzen."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4278306-9>,
        <http://lvr.vocnet.org/wnk/wk007440> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schüssel (Gefäß)"@de ;
    skos:scopeNote "Erläuterung: Der Übergang zur Schale ist fließend, aber bei Schüsseln ist die Gefäßhöhe relativ zur Breite üblicherweise größer und die einzelnen Gefäßzonen sind meist deutlicher abgesetzt als bei der Schale. Zudem besitzt die Schüssel in der Regel ein insgesamt größeres Volumen."@de .

