    skos:broader lvr:c_ef339b86 ;
    skos:definition "Ein Barren ist ein Objekt aus einer einzelnen, relativ reinen Metallsorte, das in eine einheitliche Form gegossen wurde."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4293677-9>,
        <http://lvr.vocnet.org/wnk/wk006875> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Barren (Metall)"@de ;
    skos:scopeNote "Erläuterung: In prähistorischer Zeit wurden Barren auch als Tauschmittel und Zahlungsmittel eingesetzt."@de .

