    skos:broader lvr:c_aa3281ca ;
    skos:definition "Ein Glockengrab ist ein Urnengrab, in dem die abgestellte eigentliche Urne, die Bestattung enthaltend, mit einem großen, umgestülpten, glockenähnlichen Gefäß zugedeckt ist."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk000572> ;
