    skos:broader lvr:c_befund_top_infrastruktur_und_verkehr ;
    skos:definition "Ein Kanal ist ein Bauwerk, das in Form offener, künstlicher Wasserläufe oder unterirdisch geführter Rohrleitungen für Abwässer, Bewässerung oder Entwässerung genutzt wird."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk000134>,
        <http://vocab.getty.edu/aat/300133792> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kanal (Wasserbau)"@de ;
    skos:scopeNote "Verwendungshinweis: Benutzt für künstlichen Wasserlauf für Abwässer, Bewässerung oder Entwässerung; für schiffbaren Kanal siehe Schifffahrtskanal."@de .

lvr:c_e17b9d73 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_sakralbau ;
    skos:definition "Ein Kloster ist ein Baukomplex, in dem Menschen in Ausübung ihrer Religion zusammenleben."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk000782> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kloster (Architektur)"@de ;
    skos:scopeNote "Erläuterung: Das Kloster besteht in der Regel aus Bauten für die Religionsausübung, Wohngebäuden, Wirtschaftsgebäuden, eventuell weiteren Bauwerken und Freiflächen sowie Nutzflächen wie der Innenhof des Kreuzgangs oder Gärten."@de .

lvr:c_e43f31cc a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
