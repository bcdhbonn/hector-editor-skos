    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fundansprachen"@de,
        "Find and Artifact Classifications"@en ;
    skos:topConceptOf lvr:scheme .

lvr:scheme a skos:ConceptScheme ;
    skos:definition "Ein vereintes SKOS-Vokabular der Grabungsrichtlinien des Landschaftsverbandes Rheinland (LVR)."@de,
