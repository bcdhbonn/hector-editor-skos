lvr:c_e3417bc1 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_b2892d87 ;
    skos:definition "Ein Taktstock ist ein Stab, mit dem ein Dirigent den Musikern den Takt angibt, mit dessen Hilfe die Einsätze einzelner Instrumente angezeigt werden und er seine Interpretation des Musikverlaufs verdeutlicht."@de ;
