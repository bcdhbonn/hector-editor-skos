    skos:broader lvr:c_31741601 ;
    skos:definition "Ein Nagel ist ein Befestigungselement aus Metall oder Holz, das aus einem schlanken Schaft mit einem zugespitzten Ende und einem flachen Kopf besteht. Er wird in der Regel mit einem Hammer eingeschlagen."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4419990-9>,
        <http://lvr.vocnet.org/wnk/wk008663>,
        <http://vocab.getty.edu/aat/300033565> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Nagel (Befestigungselement)"@de .

lvr:c_2f7d55fc a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    lvr:bis -497000000 ;
    lvr:von -506500000 ;
    skos:broader lvr:c_2725505e ;
    skos:definition "Das Miaolingium ist die dritte Epoche des Kambriums, die vor etwa 506,5 Millionen Jahren begann und vor etwa 497 Millionen Jahren endete."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk021223> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Miaolingium"@de .

lvr:c_300014e6 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_c6268e4c ;
    skos:definition "Ein Teller ist ein flaches, gegliedertes Gefäß zum Servieren oder für den Verzehr von Lebensmitteln. Teller besitzen in der Regel eine muldenförmige Vertiefung, sind in ihrer klassischen Ausführung rund und haben einen Durchmesser von circa 26 cm. Sie besitzen häufig einen glatten Standboden, einen abgesetzten Standring, selten einen Standfuß."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk005421>,
        <http://vocab.getty.edu/aat/300042991> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Teller (Essgeschirr)"@de ;
    skos:scopeNote "Erläuterung: Im Unterschied zur Platte (Geschirr) sind die einzelnen Gefäßzonen eines Tellers meist deutlicher abgesetzt. Teller sind in der Regel kleiner als Platten."@de .

lvr:c_33546919 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    lvr:bis -323400000 ;
    lvr:von -358860000 ;
    skos:broader lvr:c_1a919184 ;
    skos:definition "Das Mississippium ist die erste und untere geochronologische Epoche des Karbons, die vor etwa 358,86 Millionen Jahren begann und vor etwa 323,4 Millionen Jahren endete."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk002774> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Mississippium"@de .

lvr:c_349b2f70 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_48910efa ;
    skos:definition "Ein Tabernakel ist ein liturgischer Behälter, der verschließbar ist und in einer katholischen Kirche der sicheren Aufbewahrung der konsekrierten Hostien, des Allerheiligsten, dient."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4184304-6>,
        <http://lvr.vocnet.org/wnk/wk002487>,
        <http://vocab.getty.edu/aat/300207778> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Tabernakel"@de ;
    skos:scopeNote "Erläuterung: Die Verwendung des Begriffs „Tabernakel“ im heutigen Sinn beginnt im 13. Jh. Bis dahin wird mit „tabernaculum“ lediglich ein Gefäß bezeichnet, in dem die konsekrierten Hostien aufbewahrt werden."@de .

