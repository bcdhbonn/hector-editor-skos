    skos:broader lvr:c_336cf51d ;
    skos:definition "Ein Werkzeug ist ein Gerät, das zur Herstellung oder zur Bearbeitung von Werkstücken oder Rohstoffen verwendet wird."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4065596-9>,
        <http://lvr.vocnet.org/wnk/wk004589>,
        <http://vocab.getty.edu/aat/300024841> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Werkzeug"@de ;
    skos:scopeNote "Verwendungshinweis: Benutzt auch für Werkzeuge, die in Maschinen eingespannt werden (Bearbeitungswerkzeuge) oder umgangssprachlich als Instrumente bezeichnet werden, z.B. ärztliche Instrumente."@de .

lvr:c_1d92b43b a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_4f27922e ;
    skos:definition "Ein Messer ist ein Schneidewerkzeug, das über eine Klinge mit Schneide und einen Griff verfügt."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4169502-1>,
        <http://lvr.vocnet.org/wnk/wk005412>,
        <http://vocab.getty.edu/aat/300024668> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Messer (Schneidewerkzeug)"@de ;
    skos:scopeNote "Verwendungshinweis: Messer können in ihrer Funktion sowohl als Schneidwerkzeug für gezielte Schneidvorgänge, als Küchengerät zur Zubereitung von Lebensmitteln als auch als Waffe verwendet werden. Der Begriff „Messer“ (wk005412) kann als allgemeindeutiger Begriff genutzt werden. Entsprechende Unterbegriffe werden gezielt polyhierarchisch unter dem jeweils spezifischeren Oberbegriff abgelegt."@de .

lvr:c_31d4e55d a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_c9960a5e ;
    skos:exactMatch <http://d-nb.info/gnd/4040629-5>,
        <http://lvr.vocnet.org/wnk/wk005532>,
        <http://vocab.getty.edu/aat/300037222> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Münze (Tauschmittel)"@de .

lvr:c_5e4f2eca a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_38f4a5c7 ;
    skos:definition "Ein Bogen ist eine Schusswaffe zum Verschießen von Pfeilen mittels einer gespannten Sehne. Während traditionelle Bögen aus Holz, Horn und Tiersehnen gefertigt wurden, bestehen moderne Bögen in der Regel aus Holz sowie unterschiedlichen Verbundwerkstoffen."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4146210-5>,
        <http://lvr.vocnet.org/wnk/wk002306>,
        <http://vocab.getty.edu/aat/300000994> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bogen (Schusswaffe)"@de .

lvr:c_7269ca79 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_73d835d5 ;
    skos:definition "Ein Möbel ist ein großer Einrichtungsgegenstand, der der funktionalen oder dekorativen Ausstattung von Innenräumen und Außenräumen dient. Dazu zählen in erster Linie Gegenstände zum Sitzen und Liegen, Behältnismöbel sowie Tische und andere Ablagemöbel."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk002862>,
        <http://vocab.getty.edu/aat/300037680> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Möbel"@de .

lvr:c_a2adbb63 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_top_wirtschaft_gewerbe_und_industrie ;
    skos:definition "Eine Mühle ist ein Baukomplex, der aus dem Mühlengebäude mit den darin befindlichen Vorrichtungen zum Zerkleinern oder Zermahlen von stückigem Material besteht, sowie dem umgebenden Gelände einschließlich der für den Betrieb der Mühle erforderlichen Bauwerke."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk013080>,
        <http://vocab.getty.edu/aat/300201099> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Mühle (Baukomplex)"@de ;
    skos:scopeNote "Verwendungshinweis: Benutzt für Mühlen als Gesamtkomplex; für die Zerkleinerungsmaschine siehe Mühle (Maschine)."@de .

lvr:c_b6ed008f a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befundansprachen ;
    skos:definition "Eine Landschaft ist ein Teil der Erdoberfläche, der durch ein charakteristisches gleichmäßiges Erscheinungsbild und ein homogenes Wirkungsgefüge geprägt ist. Gestaltet ist eine Landschaft durch anorganische, organische und anthropogene Faktoren."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4034343-1>,
        <http://lvr.vocnet.org/wnk/wk000824> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Landschaft"@de .

lvr:c_cf3bdcc3 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_229c21d7 ;
    skos:definition "Eine Nische ist ein Bauteil, der als einseitig offene halbrunde, rechteckige oder polygonale Aussparung in einer Mauer, im Einzelfall auch in einem massiven Holz liegt."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk002349> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Nische (Architektur)"@de ;
    skos:scopeNote "Erläuterung: Wichtig an der Nische ist, dass sie zur Außenseite nicht vortritt. Andernfalls handelt es sich um einen Erker oder eine Auslucht. Im modernen Innenausbau kann eine Nische auch aus Leichtbauteilen hergestellt werden."@de .

lvr:c_0dc7d7bd a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_8ddfffa1 ;
    skos:definition "Von Stufen gebildeter Aufgang, der unterschiedlich hoch liegende Ebenen innerhalb und außerhalb von Gebäuden verbindet bzw. an Steigungen im Gelände angelegt ist."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4060816-5>,
        <http://lvr.vocnet.org/wnk/wk000115>,
        <http://vocab.getty.edu/aat/300003228> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Treppe"@de .

lvr:c_3f79d92c a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_fundansprachen ;
    skos:definition "Ein Fenster ist ein Bauteil, das als Öffnung in Mauer oder Wand zur Belichtung und Belüftung der Innenräume dient und einen Ausblick oder Einblick ermöglicht."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4016740-9>,
        <http://lvr.vocnet.org/wnk/wk000114>,
        <http://vocab.getty.edu/aat/300002944> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fenster (Architektur)"@de .

lvr:c_d7d6d8d1 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_6a0f3475 ;
    skos:definition "Von Stufen gebildeter Aufgang, der unterschiedlich hoch liegende Ebenen innerhalb und außerhalb von Gebäuden verbindet bzw. an Steigungen im Gelände angelegt ist."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4060816-5>,
        <http://lvr.vocnet.org/wnk/wk000115>,
        <http://vocab.getty.edu/aat/300003228> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Treppe"@de .

lvr:c_eed65498 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_eed65498 ;
    skos:definition "Papier ist ein dünnes, flächiges Material, das durch Verfilzen oder Verkleben von Fasern vor allem aus Pflanzen hergestellt wird."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4044522-7>,
        <http://lvr.vocnet.org/wnk/wk000340>,
        <http://vocab.getty.edu/aat/300014109> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Papier (Material)"@de .

lvr:c_ef339b86 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_fundansprachen ;
    skos:definition "Eine Objektgattung ist eine sehr allgemeine, übergeordnete Objektklassifikation, mit der Objekte anhand gemeinsamer grundlegender Eigenschaften klassifiziert werden, unabhängig von ihrem spezifischen Typ oder Kontext. Objektgattungen dienen dazu, materielle Dinge nach Kriterien wie Form, Funktion, Material, Herkunft oder kultureller Bewertung zu gruppieren und können kontextübergreifend auf verschiedene Objektarten angewendet werden. So können unter einer Objektgattung beispielsweise sowohl Kunstwerke als auch Alltagsgegenstände oder Fragmente zusammengefasst werden, je nachdem, welche Eigenschaft im jeweiligen Zusammenhang im Vordergrund steht."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk018659> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Objektgattung (Objektklassifikation)"@de .

lvr:c_548d788f a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_01e072a7 ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk019994> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Laubholz"@de .

lvr:c_7f2cf8bd a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_top_archäologischer_befund_und_architektur ;
    skos:definition "Ein Graben ist ein Erdbauwerk, das als längere, schmale Vertiefung im Boden ausgeführt ist."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4157972-0>,
        <http://lvr.vocnet.org/wnk/wk000318> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Graben (Erdbauwerk)"@de .

lvr:c_9beb6144 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_bd1f5832 ;
    skos:definition "Organisches Material ist Material, das vorwiegend aus kohlenstoffhaltigen Stoffen besteht und von Lebewesen stammt."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4203832-7>,
        <http://lvr.vocnet.org/wnk/wk012173>,
        <http://vocab.getty.edu/aat/300011792> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Organisches Material"@de .

lvr:c_merkmal a skos:Concept ;
    skos:definition "Zusatzmerkmale und Eigenschaften zur Beschreibung von Objekten laut LVR-Grabungsrichtlinien."@de ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Merkmal"@de,
        "Attributes and Characteristics"@en ;
    skos:topConceptOf lvr:scheme .

lvr:c_074153f8 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_4692515e ;
    skos:definition "Eine Landkarte ist analoges oder digitales kartographisches Material, das als zweidimensionales Medium geographische Daten maßstäblich repräsentiert. Georäumliches Wissen wird auf Basis kartographischer Abbildungsbedingungen eingeebnet, verkleinert, vereinfacht und mit Beschreibungen und Zeichen versehen dargestellt. Sachverhalte und Prozesse können über eine Karte in einen inhaltlichen Zusammenhang gestellt und übersichtlich vermittelt werden."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk004520>,
        <http://vocab.getty.edu/aat/300028094> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Landkarte"@de .

lvr:c_43929b2e a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_0fa2dc5f ;
    skos:definition "Ein Tisch ist ein Ablagemöbel, das aus einer waagerechten Platte besteht, die auf einem oder mehreren Tragelementen ruht."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4193315-1>,
        <http://lvr.vocnet.org/wnk/wk002151>,
        <http://vocab.getty.edu/aat/300039548> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Tisch"@de .

lvr:c_5fe8f7fc a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_top_infrastruktur_und_verkehr ;
    skos:definition "Ein Brunnen ist ein Bauwerk und Erdbauwerk, durch das Grundwasser zur Erdoberfläche gefördert wird."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4008491-7>,
        <http://lvr.vocnet.org/wnk/wk000308>,
        <http://vocab.getty.edu/aat/300006179> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Brunnen"@de .

lvr:c_4cddd1bd a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_229c21d7 ;
    skos:definition "Ein Tor ist ein Bauteil, das als Durchgang oder Durchfahrt für Tiere und Fahrzeuge genutzt wird und in der Regel verschließbar ist."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4060437-8>,
        <http://lvr.vocnet.org/wnk/wk000989>,
        <http://vocab.getty.edu/aat/300002916> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Tor (Architektur)"@de ;
    skos:scopeNote "Verwendungshinweis: Benutzt für das als Durchgang oder Durchfahrt genutzte funktionelle Architekturelement; für Baukomplexe bei Befestigungen siehe Toranlage."@de .

lvr:c_57db8471 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_336cf51d ;
    skos:definition "Ein landwirtschaftliches Gerät ist ein Gerät, das zur Bodenkultivierung, zur Produktion von Kulturpflanzen oder für die Aufzucht von Vieh verwendet wird."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk004628> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Landwirtschaftliches Gerät"@de .

lvr:c_29b89d38 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_fundansprachen ;
    skos:definition "Ein Ofen ist eine Vorrichtung, die sowohl transportabel als auch fest eingebaut sein kann und zur Erzeugung von Wärme dient."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4137711-4>,
        <http://lvr.vocnet.org/wnk/wk003580>,
        <http://vocab.getty.edu/aat/300052201> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ofen (Vorrichtung)"@de .

lvr:c_4143e72a a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_f621e664 ;
    skos:definition "Eine Kapelle ist ein Sakralbau, der in der Regel klein und einfach ist und keine Pfarrrechte besitzt."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4029551-5>,
        <http://lvr.vocnet.org/wnk/wk000823> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kapelle (Bauwerk)"@de ;
    skos:scopeNote "Erläuterung: Eine Kapelle kann sowohl ein selbständiges Gebäude als auch Teil eines größeren Gebäudes sein."@de .

lvr:c_50f35309 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_top_infrastruktur_und_verkehr ;
    skos:definition "Eine Brücke ist ein Bauwerk, das natürliche oder künstliche Hindernisse überspannt und über das ein Verkehrsweg führt."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4008408-5>,
        <http://lvr.vocnet.org/wnk/wk000873>,
        <http://vocab.getty.edu/aat/300007836> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Brücke (Bauwerk)"@de ;
    skos:scopeNote "Verwendungshinweis: Benutzt für ein Bauwerk, das natürliche oder künstliche Hindernisse überspannt; für ein unterirdisches Bauwerk, dessen lichte Weite weniger als zwei Meter misst, siehe Durchlass (Unterirdisches Bauwerk), für ein unterirdisches Bauwerk, dessen lichte Weite mehr als zwei Meter misst, siehe Unterführung und Tunnel."@de .

lvr:c_6d6d5c95 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_b17df6d5 ;
    skos:definition "Eine Festung ist eine Befestigungsanlage, die vorrangig zu militärischen Verteidigungszwecken dauerhaft errichtet wurde und zumeist aus mehreren untergeordneten Wehrbauten besteht."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk000312> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Festung"@de ;
    skos:scopeNote "Erläuterung: Die hauptsächlich vom Ende des 15. Jahrhunderts bis in die erste Hälfte des 20. Jahrhunderts entstandenen Festungen sind in ihrer Form und Ausbildung von der gleichzeitigen Entwicklung der Feuerwaffen abhängig."@de .

lvr:c_2089922a a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_10e70e2b ;
    skos:exactMatch <http://d-nb.info/gnd/4213323-3>,
        <http://lvr.vocnet.org/wnk/wk004790> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Leuchte"@de .

lvr:c_d74bf354 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_top_infrastruktur_und_verkehr ;
    skos:definition "Eine Straße ist ein Landverkehrsweg, der in erster Linie für die Nutzung mit Fahrzeugen angelegt ist."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4057883-5>,
        <http://lvr.vocnet.org/wnk/wk000460> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Straße"@de ;
    skos:scopeNote "Verwendungshinweis: Benutzt für die befestigte Fahrbahn sowie zugehörige Bürgersteige, Bankette, Straßengräben und Straßenbäume."@de .

lvr:c_0737738d a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_top_militär_und_befestigung ;
    skos:definition "Eine Burg ist eine Befestigungsanlage, die seit der Frühgeschichte einen in sich geschlossenen, bewohnbaren Wehrbau darstellt."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk000058> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Burg"@de ;
    skos:scopeNote "Erläuterung: Der Begriff Burg ist epochenübergreifend. Auch in der Neuzeit hat die Burg noch häufig eine zumindest rechtliche Bedeutung."@de .

lvr:c_61f24b87 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_fundansprachen ;
    skos:definition "Ein Kleidungsstück ist Ausstattung, die den Körper des Menschen bedeckt. Seine Funktion ist der Schutz vor Witterung, vor Verletzung und das Verhüllen, sie dient aber auch als Kommunikationsmittel, zum Schmuck und als Ausdruck von Mode."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk012175> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kleidungsstück"@de ;
    skos:scopeNote "Verwendungshinweis: Für konfektionierte Kleidung aus Leder, Pelz und Ähnlichem, zu denen auch Kopfbedeckungen und Fußbekleidung zählen. Für rein schmückende Accessoires verwende Schmuckstück (wk005710)."@de .

lvr:c_a93c867a a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_fundansprachen ;
    skos:definition "Ein Dach ist ein Bauteil, welches ein Bauwerk nach oben abschließt und gegen Witterungseinflüsse schützt."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk001412> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Dach"@de .

lvr:c_ca31247e a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_top_siedlung_und_religion ;
    skos:definition "Eine Siedlung ist in der gebauten Umwelt eine menschliche Niederlassung, die aus Wohnbauten und Zweckbauten sowie der dazugehörigen Infrastruktur besteht."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk000122> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Siedlung"@de .

lvr:c_b17df6d5 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_top_militär_und_befestigung ;
    skos:definition "Eine Befestigungsanlage ist ein Baukomplex, der zur Verteidigung eines Ortes oder einer Landschaft und zum Schutz gegen Zerstörung errichtet wurde."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4069225-5>,
        <http://lvr.vocnet.org/wnk/wk000313> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Befestigungsanlage"@de .

lvr:c_b2bd1501 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_12bcedfa ;
    skos:definition "Ein Turm ist ein hoch aufragendes Bauwerk mit relativ geringem Umfang. Er kann freistehend oder Teil eines größeren Bauwerks sein."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4203577-6>,
        <http://lvr.vocnet.org/wnk/wk000068> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Turm (Bauwerk)"@de .

lvr:c_f621e664 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_top_siedlung_und_religion ;
    skos:definition "Ein Kirchengebäude ist ein Sakralbau, in dem der Gottesdienst bzw. die Kultausübung verschiedener christlicher Religionsgemeinschaften abgehalten werden."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk000722> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kirchengebäude"@de .

lvr:c_0ce7abf5 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_2fa0ba76 ;
    skos:definition "Ein Garten ist ein offener Raum, der abgegrenzt, häufig auch eingefriedet ist und in dem Nutzpflanzen oder Zierpflanzen, oft beide, angebaut werden."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4019286-6>,
        <http://lvr.vocnet.org/wnk/wk002583>,
        <http://vocab.getty.edu/aat/300008090> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Garten"@de ;
    skos:scopeNote "Erläuterung: Mehr oder weniger künstlerisch oder aufwendig gestaltet ist der Garten immer vom Menschen angelegt und der Pflege bedürftig. Die Begriffe Garten und Park werden auch synonym gebraucht."@de,
        "Verwendungshinweis: Benutzt für kleinere und eindeutig abgegrenzte Anlagen, auch für Teile von Anlagen; für größere Anlagen siehe auch Park."@de .

lvr:c_31741601 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_c274e2ed ;
    skos:exactMatch <http://d-nb.info/gnd/4062621-0>,
        <http://lvr.vocnet.org/wnk/wk006114> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Verbindungselement"@de .

lvr:c_45bbc67b a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_top_wirtschaft_gewerbe_und_industrie ;
    skos:definition "Ein Ofen ist eine Vorrichtung, die sowohl transportabel als auch fest eingebaut sein kann und zur Erzeugung von Wärme dient."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4137711-4>,
        <http://lvr.vocnet.org/wnk/wk003580>,
        <http://vocab.getty.edu/aat/300052201> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Ofen (Vorrichtung)"@de .

lvr:c_295a965a a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_top_archäologischer_befund_und_architektur ;
    skos:definition "Eine Grube ist ein künstlich angelegtes Bauwerk, das als Vertiefung in der Erde sichtbar ist."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk000478> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Grube (Erdbauwerk)"@de .

lvr:c_4675490a a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_top_bestattungswesen ;
    skos:definition "Ein Grab ist ein Bauwerk, das der Aufnahme verstorbener Lebewesen dient."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk002725> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Grab"@de ;
    skos:scopeNote "Erläuterung: Das Grab kann sowohl unter der Erde als auch über der Erde errichtet werden. In verschiedenen Kulturen werden den Toten auch Gegenstände beigegeben."@de .

lvr:c_330f246b a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_12bcedfa ;
    skos:definition "Ein Wohnhaus ist ein Bauwerk, das zu Wohnzwecken erbaut und genutzt wird."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk000700> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wohnhaus"@de .

lvr:c_336cf51d a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_fundansprachen ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk004570> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gerät"@de .

lvr:c_615a1abc a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befundansprachen ;
    skos:exactMatch <http://d-nb.info/gnd/4161787-3>,
