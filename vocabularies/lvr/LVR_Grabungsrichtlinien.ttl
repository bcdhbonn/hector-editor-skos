    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_fundansprachen ;
    skos:definition "Ein Trinkgefäß ist ein kleines Gefäß für den Verzehr von Getränken, das direkt an den Mund geführt wird. Üblicherweise haben Trinkgefäße ein Fassungsvermögen von 125 bis 500 ml, solche für bestimmte Genussmittel sind oft deutlich kleiner (Espresso, Schnaps) und solche für repräsentative oder rituelle Zwecke oft deutlich größer."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4186181-4>,
        <http://lvr.vocnet.org/wnk/wk010221>,
        <http://vocab.getty.edu/aat/300194567> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Trinkgefäß"@de .

