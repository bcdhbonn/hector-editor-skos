lvr:c_09d23070 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_336cf51d ;
    skos:definition "Ein Haushaltsgerät ist ein Gerät, das zur Bewältigung von Arbeiten und Aufgaben im Haushalt verwendet wird. Es gibt elektrisch (etwa Herd, Waschmaschine, Staubsauger, Haartrockner) und mechanisch (beispielsweise Dosenöffner, Küchenwaage) betriebene sowie einfache Haushaltsgeräte (etwa Messbecher, Besen)."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk011311> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Haushaltsgerät"@de .

lvr:c_130de771 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    lvr:bis -274400000 ;
    lvr:von -298900000 ;
    skos:broader lvr:c_84c5ed09 ;
    skos:definition "Das Cisuralium ist die untere geochronologische Epoche des Perms, die vor etwa 298,9 Millionen Jahren begann und vor etwa 274,4 Millionen Jahren endete."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk002776> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Cisuralium"@de ;
    skos:scopeNote "Erläuterung: Die Beizeichnung \"Rotliegend\" gehört zu dem parallel zum Perm regional verwendeten Oberbegriff des Dyas, als Teil  einer lithostratigraphischen Supergruppe (oder Hauptgruppe) in Mitteleuropa. Das Rotliegend umfasst in seiner Datierung zwar ca. die Perioden des Cisuralium und des Guadalupium, wird heute aber nicht mehr mit den Epochen des Perm gleichgesetzt. Der Begriff wird heute in der Literatur nur noch als Gesteinseinheit (= Einheit der Lithostratigraphie) interpretiert, nicht mehr als Zeitintervall der Erdgeschichte."@de .

lvr:c_1af39bd3 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
