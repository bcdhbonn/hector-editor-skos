    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befundansprachen ;
    skos:definition "Ein Bad ist ein Bauwerk, in dem Wasser in mitunter mehreren unterschiedlich großen Behältnissen zur Erfrischung, Reinigung oder zu Heilzwecken zur Verfügung steht."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4004183-9>,
        <http://lvr.vocnet.org/wnk/wk004961> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bad (Bauwerk)"@de .

