    skos:broader lvr:c_c647e56b ;
    skos:definition "Eine Fonduegabel ist eine Gabel, die aus zwei kurzen Zinken an einem langen Stiel mit Griff - zumeist aus Holz oder Kunststoff - besteht. Fonduegabeln finden speziell beim Fondueessen zur Einbringung von Speisen in den Fonduetopf Verwendung."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk012920> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fonduegabel"@de .

lvr:c_e307655d a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_a93c867a ;
    skos:definition "Eine Dachgaupe ist der Bestandteil eines Daches, der an geneigten Dächern durch senkrecht stehende Fensterscheiben aus dem Dach herausragt."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4148722-9>,
        <http://lvr.vocnet.org/wnk/wk002562> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gaube"@de .

lvr:c_e3292a7c a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
