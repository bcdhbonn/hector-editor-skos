lvr:c_9c6cd23f a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    lvr:bis 1945 ;
    lvr:von 1933 ;
    skos:broader lvr:c_bef59501 ;
    skos:definition "Ein Konzentrationslager ist ein Gefangenenlager, welches in der Zeit des Nationalsozialismus für die Internierung und zumeist auch Ermordung von Opfern der nationalsozialistischen Unrechtsherrschaft errichtet wurde."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk000758> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Konzentrationslager"@de ;
    skos:scopeNote "Erläuterung: Die Opfer der Konzentrationslager wurden aufgrund ihrer Rasse, ihres Glaubens, ihrer Weltanschauung, sexuellen Orientierung, körperlichen oder geistigen Behinderungen oder ihrer politischen Gegnerschaft zum Nationalsozialismus verfolgt und inhaftiert. In den Lagern starben die meisten dieser Menschen an den Folgen physischer Misshandlungen, systematischer Aushungerung, Zwangsarbeit, medizinischer Menschenversuche oder wurden - vor allem im Rahmen der deutschen Judenvernichtung (Shoah bzw. Holocaust) - durch Massentötungen in Gaskammern, Erschießungen oder Todesmärsche ermordet."@de,
        "Verwendungshinweis: Benutzt für das unter der NS-Herrschaft von 1933-1945 eingerichtete und betriebene Lager; für andere Lager siehe Lager (Unterkunft) oder Gefangenenlager."@de .

