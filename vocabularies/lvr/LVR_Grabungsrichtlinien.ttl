lvr:c_87f4d2dc a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_45bbc67b ;
    skos:definition "Ein Räucherofen ist ein Ofen, in dem Fleisch, Fisch oder Geflügel speziell im Rauch zubereitet und haltbar gemacht wird."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk004385> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Räucherofen"@de ;
    skos:scopeNote "Erläuterung: Er besitzt zwei Kammern: die obere, größere ist für die Räucherware; die untere, kleinere ist für das Feuerholz, das den Rauch entwickelt und dem Fleisch das Aroma verleiht."@de .

lvr:c_87ffd184 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_de9218e8 ;
    skos:definition "Eine Amphore ist ein Transportgefäß und Vorratsgefäß der Antike, das zwei Henkel, einen engen Hals und einen bauchigen, ovalen Körper besitzt. Die meisten Amphoren wurden aus Ton hergestellt. Viele antike Amphoren haben einen spitzen Fuß und konnten dadurch nur in dafür vorgesehenen Halterungen aufrecht gelagert werden. In ihnen wurde beispielsweise  Olivenöl, Wein oder Garum aufbewahrt."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4001770-9>,
        <http://lvr.vocnet.org/wnk/wk004588>,
        <http://vocab.getty.edu/aat/300148696> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Amphore"@de ;
    skos:scopeNote "Erläuterung: Viele antike Amphoren haben einen spitzen Fuß und konnten dadurch nur in dafür vorgesehenen Halterungen aufrecht gelagert werden. In ihnen wurde beispielsweise  Olivenöl, Wein oder Garum aufbewahrt."@de .

