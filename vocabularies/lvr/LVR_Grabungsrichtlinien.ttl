    skos:broader lvr:c_2cb078f3 ;
    skos:definition "Ein Gefäßboden ist der Teil eines Gefäßes, auf dem es üblicherweise steht und der sich meist auf der der Öffnung gegenüberliegenden Seite befindet."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk018464> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gefäßboden"@de ;
    skos:scopeNote "Erläuterung: Benutzt für Gefäßböden von Hohlformen aus Metall, organischen Materialien usw.; bei Scherben eines Bodens von Hohlformen aus Ton, Glas oder Porzellan siehe Bodenscherbe."@de .

