    skos:broader lvr:c_1a9f8ffe ;
    skos:definition "Ein Flakon ist eine kleine Flasche, die hauptsächlich zur Aufbewahrung von wohlriechenden Essenzen genutzt und in der Regel durch einen Stöpsel verschlossen wird. Flakons können stattdessen auch einen Zerstäuber zum Versprühen der Flüssigkeit besitzen. Besonders antike Gefäße wurden aufwendig verziert."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4154539-4>,
        <http://lvr.vocnet.org/wnk/wk004614>,
        <http://vocab.getty.edu/aat/300197635> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Flakon"@de .

