        <http://vocab.getty.edu/aat/300011132> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Quarz"@de ;
    skos:scopeNote "Erläuterung: Quarz ist das häufigste Mineral der Erdkruste."@de .

