    skos:broader lvr:c_e7f06738 ;
    skos:definition "Eine Dachpfanne ist ein Dachziegel, mit dem ein Dach gedeckt wird. Sie ist muldenartig verformt."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk004719>,
