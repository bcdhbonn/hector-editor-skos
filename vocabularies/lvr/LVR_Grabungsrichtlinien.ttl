    skos:exactMatch <http://lvr.vocnet.org/wnk/wk001740>,
        <http://vocab.getty.edu/aat/300391265> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Silur"@de .

lvr:c_76ef322c a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_6fb36205 ;
    skos:definition "Ein Gräberfeld ist ein Bestattungsplatz, auf dem sich mehrere Bestattungen befinden, unabhängig von der Grabform oder der Bestattungsart."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk003691> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gräberfeld"@de ;
    skos:scopeNote "Verwendungshinweis: Gräberfeld benutzt für Begräbnisplätze vor dem Mittelalter; für Begräbnisplätze seit dem Mittelalter siehe Friedhof; für Begräbnisplätze an Kirchen siehe Kirchhof."@de .

lvr:c_79c2399b a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    lvr:bis -174700000 ;
    lvr:von -201400000 ;
    skos:broader lvr:c_26192b90 ;
    skos:definition "Der Unterjura ist die untere geochronologische Epoche des Juras, die vor etwa 201,4 Millionen Jahren begann und vor etwa 174,7 Millionen Jahren endete."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk002782> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Unterjura"@de ;
    skos:scopeNote """Erläuterung: Der Begriff gehört zu der lithostratigraphischen Gruppe des sogenannten Süddeutschen Jura. 
Der Schwarze Jura ist die unterste Stufe des Süddeutschen Jura.
Die Grenzen von Süddeutschem Jura und chronostratigraphischen/-chronologischen bzw. internationalem Jura stimmen jedoch nicht genau überein."""@de .

