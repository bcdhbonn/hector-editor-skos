    skos:broader lvr:c_a634295d ;
    skos:definition "Das Indusium ist ein geochronologisches Alter der Untertrias, das vor etwa 251,902 Millionen Jahren begann und vor etwa 249,9 Millionen Jahren endete."@de ;
