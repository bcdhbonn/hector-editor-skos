    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_d173927e ;
    skos:definition "Ein Fischereigerät ist ein Fanggerät, das zur Ausrüstung von Fischern gehört. Hierzu zählen etwa Angeln, Netze und Fangkammern."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4194540-2>,
        <http://lvr.vocnet.org/wnk/wk006871>,
        <http://vocab.getty.edu/aat/300024416> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fischereigerät"@de .

lvr:c_ddb8abe8 a skos:Concept ;
