    skos:broader lvr:c_31741601 ;
    skos:definition "Ein Anker ist ein Gerät, mit dem ein Wasserfahrzeug an einem bestimmten Platz festgehalten wird und nicht durch äußere Einwirkungen wie Wind, Strömung oder Wellen abgetrieben werden kann. Ein Anker besteht in der Regel aus einem Schaft und mehreren hakenförmigen Armen, auch Flunken genannt. Er ist durch eine Ankerkette mit dem Wasserfahrzeug verbunden."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk007031>,
        <http://vocab.getty.edu/aat/300219429> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Anker (Gerät)"@de .

lvr:c_e6f4570d a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_material ;
    skos:definition "Eine Objektgattung ist eine sehr allgemeine, übergeordnete Objektklassifikation, mit der Objekte anhand gemeinsamer grundlegender Eigenschaften klassifiziert werden, unabhängig von ihrem spezifischen Typ oder Kontext. Objektgattungen dienen dazu, materielle Dinge nach Kriterien wie Form, Funktion, Material, Herkunft oder kultureller Bewertung zu gruppieren und können kontextübergreifend auf verschiedene Objektarten angewendet werden. So können unter einer Objektgattung beispielsweise sowohl Kunstwerke als auch Alltagsgegenstände oder Fragmente zusammengefasst werden, je nachdem, welche Eigenschaft im jeweiligen Zusammenhang im Vordergrund steht."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk018659> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Objektgattung (Objektklassifikation)"@de .

