    skos:broader lvr:c_fundansprachen ;
    skos:definition "Ein Idiofon ist ein Musikinstrument, dessen Körper ohne zusätzliche Membranen oder Saiten den Ton erzeugt. Dazu wird das Material durch Schlagen, Schütteln, Schrapen, Zupfen oder Reiben in Schwingung versetzt."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4129454-3>,
        <http://lvr.vocnet.org/wnk/wk003182>,
        <http://vocab.getty.edu/aat/300041646> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Idiofon"@de .

lvr:c_2b5b35a5 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_7f2cf8bd ;
    skos:definition "Ein Wassergraben ist ein Bauwerk in Form eines Grabens, der künstlich angelegt oder den Verlauf eines Fließgewässers aufgreifend ausgebaut ist,  Wasser enthält und unterschiedlichen Zwecken dient, wie z.B. der Bewässerung, Entwässerung oder dem Schutz."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk001231> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wassergraben"@de .

lvr:c_2c086f94 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_438d41ba ;
    skos:definition "Ein Schwimmbad ist ein Bad oder eine Sportstätte, die aus einem oder mehreren Schwimmbecken, Umkleideräumen, gegebenenfalls Liegewiesen besteht und von einem Bademeister beaufsichtigt wird."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4077288-3>,
        <http://lvr.vocnet.org/wnk/wk000967> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schwimmbad"@de .

