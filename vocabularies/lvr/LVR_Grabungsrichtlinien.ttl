lvr:c_666e6ba4 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_2f358372 ;
    skos:definition "Ein Kleinkastell ist ein römisches Militärlager, das für kleine Einheiten wie Wachkommandos genutzt wurde."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk004221> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kleinkastell"@de ;
    skos:scopeNote "Erläuterung: Es bot Platz für etwa 40 bis 80 Mann Besatzung (Centurie bzw. Halbcenturie)."@de .

lvr:c_668412ea a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_7f2cf8bd ;
    skos:definition "Ein Wandgraben ist ein Graben, der die Lage einer Hauswand kennzeichnet."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk004211> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Wandgraben"@de ;
    skos:scopeNote "Erläuterung: Der Wandgraben kann als archäologischer Befund sowohl ein durchgehender, ungegliederter, schmaler Graben für die Aufnahme eines Schwellbalkens als auch ein schmaler Graben mit vielen kleinen Löchern für die Aufnahme einer Palisadenwand, Bretterwand o.ä. sein."@de .

lvr:c_66c6aed5 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    lvr:bis -283300000 ;
    lvr:von -290100000 ;
    skos:broader lvr:c_130de771 ;
    skos:definition "Das Artinskium ist das dritte geochronologische Alter des Cisuraliums. Es begann vor etwa 290,1 Millionen Jahren und endete vor etwa 283,3 Millionen Jahren."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk021194> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Artinskium"@de .

lvr:c_66d1f568 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_fe4e057c ;
    skos:definition "Beton ist ein Baustoff, der aus einem Gemisch aus Zement, Wasser, Gesteinskörnung über 4 Millimeter und oft weiteren Zusätzen hergestellt wird. Das Gemenge ist nach dem Vermischen zunächst plastisch verformbar und härtet nach einiger Zeit durch eine chemische Reaktion des Bindemittels zu einem festen, künstlichen Gestein aus."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4006111-5>,
        <http://lvr.vocnet.org/wnk/wk006045>,
        <http://vocab.getty.edu/aat/300010737> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Beton"@de ;
    skos:scopeNote """Erläuterung: Es handelt sich um einen historischen Baustoff mit je nach Zusammensetzung unterschiedlichen Eigenschaften. 
Der Betonzuschlag muss Körnungsanteile über 4 mm enthalten, ein Gemisch mit Zuschlagkorn bis 4 mm wird dagegen als Mörtel bezeichnet."""@de .

