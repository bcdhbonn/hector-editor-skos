lvr:c_1d17c615 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_1a9f8ffe ;
    skos:definition "Eine Siphonflasche ist eine Flasche für kohlensäurehaltige Getränke, insbesondere Sodawasser. Sie besteht meist aus Glas, Stahl oder Aluminium und verfügt über ein spezielles Steigrohr und einen Siphonkopf mit Hebel. Ursprünglich diente sie dem Aufbewahren und Ausschenken von Sodawasser, später gab es auch Varianten mit CO2-Kartusche zum Versetzen von Wasser mit Kohlensäure. Es existieren verschiedene Entwicklungsstufen von werksseitig befüllten Flaschen bis zu modernen, wiederbefüllbaren Varianten für den Hausgebrauch."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk021122>,
        <http://vocab.getty.edu/aat/300220910> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Siphonflasche"@de .

