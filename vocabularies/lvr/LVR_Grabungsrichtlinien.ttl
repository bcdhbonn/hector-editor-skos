    skos:broader lvr:c_ee8f960a ;
    skos:definition "Eine Satte ist eine flache, oft konisch geformte Schüssel, die in der vorindustriellen Milchverarbeitung der Entrahmung von Rohmilch diente. Hierzu wurde die Rohmilch in die Schüssel gegeben und ruhen gelassen, bis sich die dickflüssige Sahne oben absetzte und abgeschöpft werden konnte."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk018734> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Satte"@de .

