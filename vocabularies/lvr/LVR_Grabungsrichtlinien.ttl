lvr:c_0be71e33 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_fundansprachen ;
    skos:definition "Ein Kochtopf ist ein Kochgefäß, das der Nahrungszubereitung durch Kochen dient. Es kann aus Metall oder Keramik bestehen und besitzt einen oder zwei Griffe sowie meist einen Deckel."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk015390> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kochtopf"@de .

