    skos:definition "Das Devon ist die vierte geochronologische Periode des Paläozoikums. Es begann vor etwa 419,62 Millionen Jahren und endete vor etwa 358,86 Millionen Jahren."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk001741>,
        <http://vocab.getty.edu/aat/300391468> ;
    skos:inScheme lvr:scheme ;
