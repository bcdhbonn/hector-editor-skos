lvr:c_84c5ed09 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    lvr:bis -251902000 ;
    lvr:von -298900000 ;
    skos:broader lvr:c_7ada82f4 ;
    skos:definition "Das Perm ist die sechste und oberste Periode des Paläozoikums. Sie begann vor etwa 298,9 Millionen Jahren und endete vor etwa 251,902 Millionen Jahren."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk001757>,
        <http://vocab.getty.edu/aat/300391470> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Perm"@de ;
    skos:scopeNote "Verwendungshinweis: \"Dyas\" dient v.a. in Mitteleuropa als Name für den obersten geologischen Zeitabschnitt des Paläozoikums. Er setzte sich allerdings nicht international durch. Heute wird seine Bedeutung in wesentlichen Teilen vom international gebräuchlichen System des Perm eingenommen. Das Dyas wird in erster Linie durch markante Wechsel in der Gesteinsabfolge definiert und wird daher heute eher als Bezeichnung für eine lithostratigraphische Supergruppe (oder Hauptgruppe) in Mitteleuropa benutzt, die Rotliegend und Zechstein umfasst."@de .

lvr:c_8569e5a8 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    lvr:bis -143100000 ;
    lvr:von -161500000 ;
    skos:broader lvr:c_26192b90 ;
    skos:definition "Der Oberjura ist die obere geochronologische Epoche des Juras, die vor etwa 161,5 Millionen Jahren begann und vor etwa 143,1 Millionen Jahren endete."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk002784> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Oberjura"@de ;
    skos:scopeNote "Erläuterung: In der älteren Literatur, z. T. auch noch in der populärwissenschaftlichen Literatur, wird dieser Abschnitt häufig auch als Malm oder Weißer Jura (Weißjura) bezeichnet. Beide Begriffe sollten aber für die chronostratigraphische Einheit nicht mehr verwendet werden. Sie finden jedoch im Rahmen der lithostratigraphischen Gliederung des Süddeutschen- und Norddeutschen Jura (im Sinne einer Gruppe von Formationen) weiterhin Verwendung. Es werden zwei verschiedene stratigraphische Gliederungen vermischt."@de .

