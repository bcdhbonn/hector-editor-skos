lvr:c_9d51000d a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_0d9838e4 ;
    skos:definition "Ein Linsenboden ist ein Gefäßboden, der am Übergang zur Wandung abgerundet oder geknickt erscheint. Im Unterschied zum Kugelboden ist er weniger gerundet und nicht durch Druck geformt sondern durch Beschneiden."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk019087> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Linsenboden"@de ;
    skos:scopeNote "Erläuterung: Der Linsenboden ist ein Charakteristikum karolingischer Gefäßkeramik. Bei der Herstellung wird der verdickte Boden, von der unteren Gefäßwandung ausgehend, mittels Schnitten in eine rundliche Form gebracht. Am Übergang von Wandung zu Boden können deshalb Schnittgrate beobachtet werden. Das Gefäß kann noch stehen, ist aber durch die Rundung im Stand instabil."@de .

lvr:c_9d70fa91 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_grabanlage ;
    skos:definition "Eine Aschenkiste ist ein Behältnis, in dem die Reste einer Brandbestattung aufbewahrt werden."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk004112> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Aschenkiste"@de ;
    skos:scopeNote "Erläuterung: Eine Aschenkiste ist ähnlich einem Sarkophag, kann aber deutlich kleiner sein. Sie nimmt die vom Verbrennungsplatz ausgelesenen Reste der Brandbestattung auf. Eine Aschenkiste muss nicht in der Erde bestattet sein."@de,
        "Verwendungshinweis: Benutzt für das Behältnis zur Aufbewahrung von Resten einer Brandbestattung; für den Bestandteil eines Ofens siehe Aschkasten."@de .

