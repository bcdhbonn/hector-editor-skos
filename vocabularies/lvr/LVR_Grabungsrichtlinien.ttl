lvr:c_624e0c0c a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_ef339b86 ;
    skos:definition "Ein Steinartefakt ist ein Artefakt aus Stein. Im engeren Sinne werden darunter vom Menschen geschlagene oder überschliffene Objekte aus Silikat- oder Felsgestein bezeichnet."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk020091> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Steinartefakt"@de ;
    skos:scopeNote "Verwendungshinweis: Steinartefakt bezieht sich hier auf geschlagene oder geschliffene Steinartefakte. Dies schließt keine Baumaterialien wie Steinquader o.ä. ein."@de .

lvr:c_66daa1db a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_top_siedlung_und_religion ;
    skos:definition "Eine Villa ist ein Wohnhaus, das als repräsentativer Bau auf dem Lande oder im Randbereich von städtischen Ansiedlungen steht und meist nur einer Familie dient."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk000784> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Villa"@de ;
    skos:scopeNote "Erläuterung: Der Begriff Villa wurde in der Antike für repräsentative Landsitze geprägt. Die dem zugrunde liegende Idee blieb bis in die Gegenwart erhalten. In römischer Zeit wurde begrifflich zwischen ländlichen, vorstädtischen und städtischen Villen unterschieden. In nachrömischer Zeit wurde derartige begriffliche Unterschiede nicht mehr gemacht."@de,
        "Verwendungshinweis: Benutzt für Villen allgemein; für Villen in römischer Zeit siehe Villa rustica für ländliche Villen und Villa urbana für städtische Villen."@de .

