    skos:broader lvr:c_6507af41 ;
    skos:definition "Die Oberkreide ist die obere geochronologische Epoche der Kreide, die vor etwa 100,5 Millionen Jahren begann und vor etwa 66 Millionen Jahren endete."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk002786>,
        <http://vocab.getty.edu/aat/300391282> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Oberkreide"@de .

lvr:c_d2a2eb61 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_b17df6d5 ;
    skos:definition "Eine Schanze ist eine Feldbefestigung, die aus einem Wall aus aufgeworfener Erde besteht und mit einem Graben ausgestattet ist."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4165298-8>,
        <http://lvr.vocnet.org/wnk/wk006320>,
        <http://vocab.getty.edu/aat/300194498> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schanze (Befestigungsanlage)"@de .

lvr:c_d52ba3a0 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_2fa0ba76 ;
    skos:definition "Ein Hof ist ein Baukomplex, der alle zu einem Landwirtschaftsbetrieb gehörigen Bauwerke und die in unmittelbarem Zusammenhang mit den Bauwerken stehenden Flächen umfasst."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4137817-9>,
        <http://lvr.vocnet.org/wnk/wk001352> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Hof (Landwirtschaft)"@de ;
    skos:scopeNote "Verwendungshinweis: Benutzt ausschließlich für den Baukomplex; für Baukomplex mit Nutzfläche siehe Landwirtschaftsbetrieb."@de .

lvr:c_d75258c9 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_2fa0ba76 ;
    skos:definition "Ein Park ist ein offener Raum, der abgegrenzt, häufig eingefriedet, vom Menschen mehr oder weniger künstlerisch oder aufwendig gestaltet und der Pflege bedürftig ist, aber auch gestalterisch mit der Umgebung verbunden sein kann, beispielsweise durch ein Ha-Ha."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk000421> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Park"@de ;
    skos:scopeNote "Erläuterung: Gestaltungselemente sind vor allem Gehölze, Rasenflächen und Wiesenflächen, Gewässer und Wegesysteme. Innerhalb eines Parks können sich Gärten befinden, die dem Anbau bestimmter Pflanzen dienen (zum Beispiel Küchengärten). Die Begriffe Garten und Park werden allerdings häufig synonym gebraucht."@de,
        "Verwendungshinweis: Benutzt für größere Anlagen, die wesentlich durch Baumbestand bestimmt sind."@de .

lvr:c_de740532 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_971418fd ;
    skos:definition "Eine Säule ist eine Stütze, die einen kreisförmigen Querschnitt hat, im Gegensatz zum Rundpfeiler in der Regel mit Verjüngung und manchmal auch mit Entasis. Sie lässt sich gewöhnlich in Basis, Schaft und Kapitell gliedern."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4178902-7>,
        <http://lvr.vocnet.org/wnk/wk001390>,
        <http://vocab.getty.edu/aat/300001571> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Säule"@de .

lvr:c_e6c37d8b a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befundansprachen ;
    skos:definition "Eine Einfriedung ist ein Element, das den Zugang zu dem durch die Einfriedung umschlossenen Bereich nur durch ein Tor, eine Schranke oder ähnliches erlaubt."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4226465-0>,
        <http://lvr.vocnet.org/wnk/wk000942> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Einfriedung"@de .

lvr:c_ebe96f8f a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_aabe3053 ;
    skos:definition "Ein Gewölbe ist ein Bauteil, der als gebogene Fläche einen Raum nach oben abschließt."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4197155-3>,
        <http://lvr.vocnet.org/wnk/wk001370>,
        <http://vocab.getty.edu/aat/300001324> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gewölbe (Bauteil)"@de .

lvr:c_f26c2657 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_6f049a20 ;
    skos:definition "Eine Plastik ist ein visuelles Werk, das modelliert oder gegossen wird."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4033676-1>,
        <http://lvr.vocnet.org/wnk/wk007097> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Plastik (visuelles Werk)"@de ;
    skos:scopeNote "Verwendungshinweis: Benutzt für visuelle Werke, die aus Materialien modelliert oder gegossen werden; für visuelle Werke, die aus einem Material herausgearbeitet werden, siehe Skulptur."@de .

