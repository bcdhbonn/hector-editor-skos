    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_e16405c9 ;
    skos:definition "Ein Balken ist ein Bauteil, das als Träger horizontal gelagert ist und vertikal wirkende Kräfte aufnimmt und weitergibt."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4004336-8>,
        <http://lvr.vocnet.org/wnk/wk003440>,
        <http://vocab.getty.edu/aat/300001497> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Balken (Bauteil)"@de .

lvr:c_3d888db7 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_e16a8404 ;
    skos:definition "Ein Bergwerksschacht ist der Bestandteil einer Untertageanlage, der senkrecht, oder seltener auch schräg, Lagerstätten erschließt."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4144668-9>,
        <http://lvr.vocnet.org/wnk/wk001120> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bergwerksschacht"@de .

lvr:c_4f27922e a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_336cf51d ;
    skos:definition "Ein Schneidewerkzeug ist ein Gerät zum Schneiden."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4179862-4>,
        <http://lvr.vocnet.org/wnk/wk007001>,
        <http://vocab.getty.edu/aat/300163290> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schneidewerkzeug"@de .

lvr:c_7acc1037 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_0a28ee6e ;
    skos:definition "Ein Schlaginstrument ist ein Musikinstrument, auf dem durch Schlagen oder Schütteln Klänge erzeugt werden."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk003184> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schlaginstrument"@de .

lvr:c_9da32f2e a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_a779bba1 ;
    skos:definition "Gestein ist ein anorganisches Material mit einer spezifischen Zusammensetzung von Mineralen."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk000352>,
        <http://vocab.getty.edu/aat/300011692> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gestein"@de ;
    skos:scopeNote "Erläuterung: Gesteinsarten bilden den festen Teil der Erdkruste und werden nach ihrer Entstehung unterteilt in magmatische, sedimentäre und metamorphe Gesteine."@de .

lvr:c_a388ea67 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_496c9697 ;
    skos:definition "Steinzeug ist Keramik, die beim Brennprozess versintert oder verglast und über einen nicht durchscheinenden und fast wasserdichten Scherben verfügt. Meist wird das Material zusätzlich glasiert."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk010434> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Steinzeug (Material)"@de .

lvr:c_a650e466 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_7bed0ee8 ;
    skos:definition "Ein Stuhl ist ein Sitzmöbel für eine Person, das eine Rückenlehne besitzt und deren Sitzfläche eher hoch ist. Stühle können auch über Armlehnen verfügen und teilweise gepolstert sein."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk005472> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Stuhl (Möbel)"@de .

lvr:c_b84deb72 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_fundansprachen ;
    skos:definition "Ein Spielzeug ist ein Freizeitgegenstand, der der spielerischen Beschäftigung dient und sich in erster Linie an Kinder richtet, aber auch eigens für Erwachsene und Haustiere bestimmt sein kann. Über die spielerische Komponente hinaus kann ein Spielzeug auch eine pädagogische oder sozialisierende Funktion besitzen."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk005541> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Spielzeug"@de .

lvr:c_c274e2ed a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_fundansprachen ;
    skos:definition "Ein Bestandteil ist ein Objekt, das Teil eines größeren Ganzen ist und dessen Funktion oder Bedeutung in der Regel in diesem Zusammenhang steht."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk018638>,
        <http://vocab.getty.edu/aat/300241583> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bestandteil"@de .

lvr:c_cd669d8f a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_e6c37d8b ;
    skos:definition "Ein Zaun ist eine Einfriedung, die aus Holz oder Metall besteht und offene Räume voneinander abgrenzt oder schützend umgibt."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4128356-9>,
        <http://lvr.vocnet.org/wnk/wk001484> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Zaun"@de .

lvr:c_de8b6d95 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_fundansprachen ;
    skos:definition "Ein Schmuckstück ist Bekleidungszubehör, das als optische Aufwertung von Kleidung oder zur Zierde des Trägers am Körper getragen wird. Schmuck wird sowohl nach Form, Funktion und Material kategorisiert als auch nach Preis, Anlass und Art der Anbringung."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk005710> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schmuckstück"@de ;
    skos:scopeNote "Verwendungshinweis: Verwendet für Schmuckstücke, die am Körper oder an Kleidungsstücken getragen werden."@de .

lvr:c_df039ae0 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_fundansprachen ;
    skos:definition "Ein Buch ist ein Informationsträger, der aus einer Sammlung gedruckter, beschriebener aber auch leerer Blätter aus Papier oder ähnlichen Materialien bestehen kann. Diese Einzelblätter sind durch eine Bindung oder Heftung verbunden und zumeist durch einen Bucheinband geschützt."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk005226> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Buch (Informationsträger)"@de .

lvr:c_e8566ee0 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_5be9db4b ;
    skos:definition "Ein Geschoss ist Munition, die durch eine Abwurfvorrichtung oder Abschussvorrichtung auf eine hohe Geschwindigkeit gebracht wird. Das Geschoss fliegt nach dem Abschuss ungelenkt und ohne weiteren Antrieb."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4157031-5>,
        <http://lvr.vocnet.org/wnk/wk009872> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Geschoss (Munition)"@de .

lvr:c_e93f55a6 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_a3070d2c ;
    skos:definition "Ein Stall ist ein Gebäude oder ein Gebäudeteil, in dem Tiere untergebracht werden."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk000128>,
        <http://vocab.getty.edu/aat/300005015> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Stall"@de .

lvr:c_f308b342 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_ccfe6b18 ;
    skos:definition "Ein Balken ist ein Bauteil, das als Träger horizontal gelagert ist und vertikal wirkende Kräfte aufnimmt und weitergibt."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4004336-8>,
        <http://lvr.vocnet.org/wnk/wk003440>,
        <http://vocab.getty.edu/aat/300001497> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Balken (Bauteil)"@de .

lvr:c_f8f2bc71 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_erdbauwerk ;
    skos:definition "Eine Aufschüttung ist ein Erdbauwerk in Form einer künstlichen Erhöhung, die durch die Anhäufung von Material entstanden ist."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4500221-6>,
        <http://lvr.vocnet.org/wnk/wk000658> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Aufschüttung (Bauwerk)"@de .

lvr:c_fd552ebf a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_fundansprachen ;
    skos:definition "Ein Gesims ist ein Architekturelement, das als verhältnismäßig schmaler Streifen plastisch hervortritt, meist horizontal verläuft und Wände in einzelne Abschnitte gliedert oder abschließt."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk002252> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Gesims"@de ;
    skos:scopeNote "Erläuterung: Ein Gesims kann von Wandöffnungen unterbrochen oder um diese herumgeführt werden."@de .

lvr:c_033e4490 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_618880b2 ;
    skos:definition "Eine Quelle ist ein Gewässer, bei dem Grundwasser auf natürliche Weise austritt, wodurch ein Übergangsbereich zwischen Grundwasser und Fließgewässer ausgebildet wird."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4176696-9>,
        <http://lvr.vocnet.org/wnk/wk000905>,
        <http://vocab.getty.edu/aat/300008697> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Quelle (Gewässer)"@de .

lvr:c_14277065 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_a779bba1 ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk000346> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Mineral"@de ;
    skos:scopeNote "Erläuterung: Minerale sind die Grundbausteine der Erde und aller anderen Himmelskörper."@de .

lvr:c_2590074e a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_fbd78860 ;
    skos:definition "Eine Panzerung ist feste Schutzkleidung, die den Körper im Kampf vor Verletzungen durch Stiche, Stöße oder Schüsse schützen soll."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk010695> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Panzerung (Schutzkleidung)"@de .

lvr:c_62a591ef a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_5be20864 ;
    skos:exactMatch <http://d-nb.info/gnd/4134177-6>,
        <http://lvr.vocnet.org/wnk/wk000184>,
        <http://vocab.getty.edu/aat/300008688> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Teich"@de .

lvr:c_79452c26 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_a9813068 ;
    skos:definition "Ein Weg ist ein Landverkehrsweg, der begehbar oder befahrbar und meistens kaum oder gar nicht befestigt ist."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4189360-8>,
        <http://lvr.vocnet.org/wnk/wk000130> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Weg (Verkehr)"@de .

lvr:c_99598b45 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_a012bcd5 ;
    skos:definition "Ein Schrank ist ein Kastenmöbel, das mit Türen verschlossen wird und dem Verstauen verschiedenster Objekte dient."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4179953-7>,
        <http://lvr.vocnet.org/wnk/wk005467>,
        <http://vocab.getty.edu/aat/300039183> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schrank (Möbel)"@de ;
    skos:scopeNote "Erläuterung: Je nach Zweck und aufbewahrtem Inhalt variiert die Form des Schrankes und die Art und Weise wie er aufgestellt, eingebaut oder an der Wand angebracht wird."@de .

lvr:c_a779bba1 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_bd1f5832 ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk012172>,
        <http://vocab.getty.edu/aat/300010360> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Anorganisches Material"@de .

lvr:c_a82ae810 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_c9aaced0 ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk008626> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kern (Steinartefakt)"@de .

lvr:c_ae5f7de6 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_52097836 ;
    skos:definition "Ein Abzug ist ein auf Fotopapier kopiertes Foto. Die Vorlage, etwa ein Negativfilm, ein Dia oder eine Bilddatei, wird dafür mittels fotografischer Verfahren wie Kontaktkopie, Vergrößerung oder Ausbelichtung übertragen."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4141215-1>,
        <http://lvr.vocnet.org/wnk/wk008249>,
        <http://vocab.getty.edu/aat/300127104> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Abzug (Foto)"@de .

lvr:c_e6e2ced0 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_top_archäologischer_befund_und_architektur ;
    skos:definition "Eine Schicht ist eine einheitlich strukturierte, räumlich begrenzte, meist horizontal liegende Bodenverfärbung oder Materialkonzentration. Diese Schichten können natürlich entstanden oder künstlich angelegt worden sein."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk000653> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Schicht (Archäologie)"@de .

lvr:c_ec21e24d a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_top_archäologischer_befund_und_architektur ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk002614> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Pfosten"@de .

lvr:c_f6151dda a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_a2adbb63 ;
    skos:definition "Eine Windmühle ist eine Mühle, an deren turmartigem Gebäude Flügel angebracht sind, die mit Windkraft die im Inneren des Gebäudes liegenden Vorrichtungen antreiben."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4066279-2>,
        <http://lvr.vocnet.org/wnk/wk002571>,
        <http://vocab.getty.edu/aat/300006273> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Windmühle"@de .

lvr:c_048b62c6 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_top_infrastruktur_und_verkehr ;
    skos:definition "Ein Hafen ist ein Baukomplex, der  aus einem künstlich angelegten Wasserbecken und der dazugehörigen Infrastruktur an Land besteht."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk001110> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Hafen"@de ;
    skos:scopeNote "Erläuterung: Er dient der Passagierabfertigung und dem Güterumschlag im Schiffsverkehr. Je nach Hauptfunktion unterscheidet man unterschiedliche Hafenarten."@de .

lvr:c_0a28ee6e a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_906a6a3c ;
    skos:definition "Ein Musikinstrument ist ein Tonerzeuger, das dazu bestimmt ist, auf ihm Musik zu spielen."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk001285> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Musikinstrument"@de .

lvr:c_1a9f8ffe a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_b39710ce ;
    skos:definition "Eine Flasche ist ein dicht verschließbares Gefäß mit enger, oft deutlich abgesetzter Halspartie, in der Regel ohne Handhabe. Im Verhältnis zur Höhe weist die Flasche typischerweise einen geringen Durchmesser auf. Das Gefäß wird hauptsächlich zum Transport und zur Lagerung von Flüssigkeiten verwendet und besteht üblicherweise aus Glas, Keramik, Kunststoff oder Metall."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4154567-9>,
        <http://lvr.vocnet.org/wnk/wk004610>,
        <http://vocab.getty.edu/aat/300045627> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Flasche"@de ;
    skos:scopeNote "Erläuterung: Die Flasche ist aus typologischer und herstellungstechnischer Sicht durch eine große Bandbreite an Varianten vertreten. Eine einheitliche Beschreibung der Gefäße ist durch die vielen unterschiedlichen regionalen Prägungen schwierig. Formenkundliche Ausnahmen bilden beispielsweise Flaschenformen mit Henkel und auch solche, die in ihrer Funktion für keine trinkbaren Flüssigkeiten gedacht sind."@de .

lvr:c_2ca49ec2 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befund_top_wirtschaft_gewerbe_und_industrie ;
    skos:definition "Eine Werkstatt ist ein Raum, in dem alle Arbeitsmittel vorhanden sind, die zur Herstellung oder Reparatur einer Ware in handwerklicher Tätigkeit erforderlich sind."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk001093>,
        <http://vocab.getty.edu/aat/300004531> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Werkstatt"@de .

lvr:c_2f7b944f a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_fundansprachen ;
    skos:definition "Ein Behälter ist ein Gegenstand, der dazu dient, andere Objekte oder festes, flüssiges oder gasförmiges Material in seinem Inneren aufzunehmen und der je nach Ausprägung zum Sammeln, Aufbewahren oder Transportieren, zum Zusammenhalten, zum Schutz seines Inhalts, zum Präsentieren oder Darreichen verwendet wird."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk000202>,
        <http://vocab.getty.edu/aat/300197197> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Behälter"@de .

lvr:c_2fa0ba76 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_befundansprachen ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk020260> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Freiraum (gebaute Umwelt)"@de .

lvr:c_44208491 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_41a17e74 ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk007002> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Foto"@de .

lvr:c_4bf28b10 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_fundansprachen ;
    skos:definition "Eine Waffe ist ein Instrument oder eine Vorrichtung, die bei Angriff, Verteidigung oder bei der Jagd zum Verletzen von Lebewesen oder zum Beschädigen von Objekten dient."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4064228-8>,
        <http://lvr.vocnet.org/wnk/wk002867>,
        <http://vocab.getty.edu/aat/300036926> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Waffe"@de .

lvr:c_611fe970 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_c274e2ed ;
    skos:definition "Ein Bauelement (das Bauteil) ist ein Bestandteil von Bauwerken, das eine funktionelle Einheit bildet und dabei meist kleiner ist als ein Raum. Dazu gehören etwa Wände, Decken, Stützen, aber auch Bauteilgruppen wie Fenster und Treppen und dekorative Architekturelemente wie Gesimse, Friese oder Kapitelle."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk000112>,
        <http://vocab.getty.edu/aat/300000885> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bauteil (Bauwesen)"@de .

lvr:c_8eb48628 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_accb42af ;
    skos:definition "Eine Uhr ist ein Messgerät, auf dem die aktuelle Uhrzeit ablesbar ist oder das eine Zeitspanne misst."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4697379-5>,
        <http://lvr.vocnet.org/wnk/wk003319> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Uhr"@de .

lvr:c_a7e65246 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_b39710ce ;
    skos:definition "Eine Kanne ist ein Gefäß mit einer Ausgußvorrichtung, meist in Form eines schnabelförmigen, schnauzenförmigen oder röhrenförmigem Ausgusses. Außerdem verfügen Kannen über mindestens einen Henkel, seltener einen Bügel; ein Deckel ist möglich. Vor allem antike Gefäße können eine abgesetzte Halszone besitzen. Prinzipiell werden Kannen zum Ausgießen und Aufbewahren von Flüssigkeiten verwendet."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk005003> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Kanne (Gefäß)"@de ;
    skos:scopeNote "Erläuterung: Die Fachliteratur ist besonders in Bezug auf die typologischen Merkmalen von Kanne und Krug nicht immer kongruent. Der Begriff Kanne soll hier als Gefäß mit Ausguss im Gegensatz zu dem Begriff Krug ohne Ausguss verstanden werden. Formale und funktionale Überlappungen beider Gefäße sind bekannt, sollen aber in der Definition nicht berücksichtigt werden."@de .

lvr:c_b2e39ab9 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_53e5fb14 ;
    skos:definition "Eine Fibel ist ein Schmuckstück, das dem Verschließen von Kleidungsstücken dient."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4071199-7>,
        <http://lvr.vocnet.org/wnk/wk005726>,
        <http://vocab.getty.edu/aat/300209303> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Fibel (Verschluss)"@de .

lvr:c_b385c55b a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
    dcterms:source <https://bodendenkmalpflege.lvr.de/de/service/grabungsrichtlinien/grabungsrichtlinien_1.html> ;
    skos:broader lvr:c_fundansprachen ;
    skos:definition "Ein Giebel ist ein Bauteil, der den quer zur Firstrichtung stehenden Abschluss eines Dachgeschosses bildet."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4157331-6>,
