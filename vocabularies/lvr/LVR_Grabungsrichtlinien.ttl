    skos:definition "Bastfaser ist eine Pflanzenfaser, die in Form von mehrzelligen Faserbündeln im Bast verschiedener Pflanzenarten vorhanden ist."@de ;
    skos:exactMatch <http://d-nb.info/gnd/4273547-6>,
        <http://lvr.vocnet.org/wnk/wk003027> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Bastfaser"@de ;
    skos:scopeNote "Erläuterung: Bastfasern werden für die Erzeugung von Seilen, Garnen, Matten oder Geweben verwendet und finden sowohl im textilen als auch im industriellen Bereich Verwendung."@de .

lvr:c_6af5a658 a skos:Concept ;
