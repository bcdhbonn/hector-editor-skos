    skos:inScheme lvr:scheme ;
    skos:prefLabel "Verfüllung"@de ;
    skos:scopeNote "Erläuterung: Bezeichnet bei der archäologischen Schichtenansprache das Material, mit dem ein Hohlraum intentionell oder natürlich wieder aufgefüllt wurde"@de .

