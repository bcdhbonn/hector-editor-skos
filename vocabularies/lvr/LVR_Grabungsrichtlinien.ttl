    skos:broader lvr:c_336cf51d ;
    skos:definition "Eine Handramme ist ein manuell geführtes Baugerät, das aus einem schweren, oft eisenbeschlagenen Holz- oder Metallklotz mit Handgriffen besteht. Sie wird verwendet, um Pfähle in den Boden einzuschlagen oder frisch verlegtes Pflaster fest zu verdichten. Die Handramme ist typischerweise für Gründungs- und Straßenarbeiten konzipiert und kann von einer oder mehreren Personen bedient werden."@de ;
    skos:exactMatch <http://lvr.vocnet.org/wnk/wk021035> ;
    skos:inScheme lvr:scheme ;
    skos:prefLabel "Handramme"@de .

lvr:c_1d3926f5 a skos:Concept ;
    dcterms:creator "Landschaftsverband Rheinland (LVR)"@de ;
